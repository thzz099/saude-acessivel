# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# Painel do Turso (app.turso.tech) > seu banco > aba "Connect"
TURSO_DATABASE_URL=libsql://seu-banco-seuusuario.turso.io
TURSO_AUTH_TOKEN=cole_aqui_o_token

# Mínimo 32 caracteres. Gere um aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Emails que viram ADMINISTRADOR automaticamente (separe por vírgula).
# A pessoa precisa ter conta criada; o perfil é aplicado no login.
ADMIN_EMAILS=
